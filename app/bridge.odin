package app

// Odin side of binding/api/bridge.h — the exported half.
// (The imported half — platform_* — lives in libs:bridge, generated by
// odin-c-bindgen from the same header.)

import "core:c"
import b "libs:bridge"

@(export)
odin_hello :: proc "c" () -> cstring {
	return cstring("Hello from Odin")
}

@(export)
odin_add :: proc "c" (a, b: i32) -> i32 {
	return a + b
}

// call once during app init: proves the odin -> platform direction
bridge_init :: proc() {
	b.platform_show_toast("hello from odin")
}
