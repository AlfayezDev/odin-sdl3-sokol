#version 310 es
// Mali-compat compute, GLSL ES for sokol's GLES3 backend. Mali drivers
// (MT6789 Mali-G57 verified) cannot execute BDA pointer dereference in
// compute (silently dropped or compiler SEGV), so this shim reads nothing:
// the RW image lives at array index 3 (resources_setup heap slot) and the
// results values are encoded in the image alpha channel for readback via
// texture copy (see resources.odin).
layout(local_size_x=4) in;
layout(binding=0, rgba8) uniform image2D images[];
void main() {
    uint i=gl_GlobalInvocationID.x;
    imageStore(images[3], ivec2(int(i), 0), vec4(1.0, 0.5, 0.25, float(i*3u+11u)/255.0));
}
