package odinbinder

import "core:fmt"
import "core:os"
import "core:path/filepath"
import "core:strings"

write_text :: proc(path, content: string) -> string {
	parent := filepath.dir(path)
	if parent != "" do os.mkdir_all(parent)
	body := strings.trim_right(content, "\n")
	trimmed := strings.concatenate([]string{body, "\n"})
	if existing, err := os.read_entire_file_from_path(path, context.allocator); err == nil {
		if string(existing) == trimmed do return ""
	}
	if err := os.write_entire_file_from_string(path, trimmed); err != nil {
		return fmt.tprintf("cannot write %s", path)
	}
	return ""
}

line :: proc(b: ^strings.Builder, indent: int, text: string) {
	if text == "" {
		strings.write_byte(b, '\n')
		return
	}
	for _ in 0 ..< indent * 4 do strings.write_byte(b, ' ')
	strings.write_string(b, text)
	strings.write_byte(b, '\n')
}

module_guard :: proc(name: string) -> string {
	out := strings.Builder{}
	strings.builder_init(&out)
	for c in name {
		if (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') {
			strings.write_rune(&out, c)
		} else {
			strings.write_byte(&out, '_')
		}
	}
	upper, _ := strings.to_upper(strings.to_string(out))
	if upper == "" do return "ODINBINDER"
	return upper
}

emit_header :: proc(module: Module, path: string) -> string {
	b := strings.Builder{}
	strings.builder_init(&b)
	guard := strings.concatenate([]string{module_guard(module.name), "_H"})
	line(&b, 0, "/* generated by odinbinder - do not edit by hand. */")
	line(&b, 0, fmt.tprintf("#ifndef %s", guard))
	line(&b, 0, fmt.tprintf("#define %s", guard))
	line(&b, 0, "")
	line(&b, 0, "#include <stdint.h>")
	line(&b, 0, "#include <stdbool.h>")
	line(&b, 0, "")
	line(&b, 0, "#ifdef __cplusplus")
	line(&b, 0, "extern \"C\" {")
	line(&b, 0, "#endif")
	line(&b, 1, "")
	line(&b, 0, "/* exports: native -> platform */")
	for f in module.functions {
		if f.direction != .Export do continue
		params := make([dynamic]string)
		for p in f.params do append(&params, fmt.tprintf("%s %s", c_type_for(module, p.typ), p.name))
		args := "void"
		if len(params) > 0 do args = strings.join(params[:], ", ")
		ret := c_type_for(module, f.ret)
		if f.ret == "" do ret = "void"
		line(&b, 0, fmt.tprintf("%s %s(%s);", ret, f.name, args))
		line(&b, 0, "")
	}
	line(&b, 0, "/* imports: platform -> native */")
	for f in module.functions {
		if f.direction != .Import do continue
		params := make([dynamic]string)
		for p in f.params do append(&params, fmt.tprintf("%s %s", c_type_for(module, p.typ), p.name))
		args := "void"
		if len(params) > 0 do args = strings.join(params[:], ", ")
		ret := c_type_for(module, f.ret)
		if f.ret == "" do ret = "void"
		line(&b, 0, fmt.tprintf("%s %s(%s);", ret, f.name, args))
		line(&b, 0, "")
	}
	line(&b, 0, "#ifdef __cplusplus")
	line(&b, 0, "}")
	line(&b, 0, "#endif")
	line(&b, 0, "")
	line(&b, 0, fmt.tprintf("#endif /* %s */", guard))
	return write_text(path, strings.to_string(b))
}

kotlin_default :: proc(name: string) -> string {
	switch name {
	case "i8", "i16", "i32", "i64":
		return "0"
	case "u8", "u16", "u32", "u64":
		return "0"
	case "f32":
		return "0f"
	case "f64":
		return "0.0"
	case "bool":
		return "false"
	}
	return ""
}

emit_kotlin :: proc(module: Module, path: string) -> string {
	b := strings.Builder{}
	strings.builder_init(&b)
	line(&b, 0, fmt.tprintf("package %s", module.android_pkg))
	line(&b, 0, "")
	line(&b, 0, "// generated by odinbinder - do not edit by hand.")
	for e in module.enums {
		line(
			&b,
			0,
			fmt.tprintf("enum class %s(val value: %s) %s", e.name, kotlin_type(e.underlying), "{"),
		)
		for f, i in e.fields {
			suffix := i + 1 < len(e.fields) ? "," : ";"
			line(
				&b,
				1,
				fmt.tprintf(
					"%s(%s)%s",
					kotlin_ident(f.name),
					kotlin_enum_literal(e.underlying, f.value),
					suffix,
				),
			)
		}
		line(&b, 1, "companion object {")
		line(
			&b,
			2,
			fmt.tprintf(
				"fun fromValue(value: %s): %s = entries.firstOrNull %s it.value == value %s ?: %s",
				kotlin_type(e.underlying),
				e.name,
				"{",
				"}",
				kotlin_ident(e.fields[0].name),
			),
		)
		line(&b, 1, "}")
		line(&b, 0, "}")
		line(&b, 0, "")
	}
	line(&b, 0, fmt.tprintf("object %s %s", module.android_class, "{"))
	has_imports := false
	for f in module.functions do if f.direction == .Import do has_imports = true
	if has_imports {
		line(&b, 1, "interface PlatformHandler {")
		for f in module.functions {
			if f.direction != .Import do continue
			params := make([dynamic]string)
			for p in f.params {
				append(&params, fmt.tprintf("%s: %s", p.name, kotlin_type_for(module, p.typ)))
			}
			ret := ""
			if f.ret != "" do ret = strings.concatenate([]string{": ", kotlin_type_for(module, f.ret)})
			line(
				&b,
				2,
				fmt.tprintf(
					"fun %s(%s)%s",
					kotlin_ident(camel(f.name)),
					strings.join(params[:], ", "),
					ret,
				),
			)
		}
		line(&b, 1, "}")
		line(&b, 1, "")
		line(&b, 1, "@JvmStatic var platform: PlatformHandler? = null")
		line(
			&b,
			1,
			"private val mainHandler = android.os.Handler(android.os.Looper.getMainLooper())",
		)
		line(&b, 1, "")
	}
	line(&b, 1, "// native -> Kotlin (exports)")
	for f in module.functions {
		if f.direction != .Export do continue
		uses_enum := function_uses_enum(module, f)
		native_name := kotlin_export_name(module, f)
		params := make([dynamic]string)
		for p in f.params {
			typ := kotlin_type_for(module, p.typ)
			if u, ok := enum_underlying(module, p.typ); ok do typ = kotlin_type(u)
			append(&params, fmt.tprintf("%s: %s", p.name, typ))
		}
		ret_typ := ""
		if f.ret != "" {
			typ := kotlin_type_for(module, f.ret)
			if u, ok := enum_underlying(module, f.ret); ok do typ = kotlin_type(u)
			ret_typ = strings.concatenate([]string{": ", typ})
		}
		if uses_enum {
			line(
				&b,
				1,
				fmt.tprintf(
					"@JvmStatic private external fun %s(%s)%s",
					kotlin_ident(native_name),
					strings.join(params[:], ", "),
					ret_typ,
				),
			)
			// Public wrapper with enum types.
			public_params := make([dynamic]string)
			call_args := make([dynamic]string)
			for p in f.params {
				append(
					&public_params,
					fmt.tprintf("%s: %s", p.name, kotlin_type_for(module, p.typ)),
				)
				if _, ok := find_enum(module, p.typ); ok {
					append(&call_args, fmt.tprintf("%s.value", p.name))
				} else {
					append(&call_args, p.name)
				}
			}
			public_ret := ""
			if f.ret != "" {
				public_ret = strings.concatenate([]string{": ", kotlin_type_for(module, f.ret)})
			}
			line(
				&b,
				1,
				fmt.tprintf(
					"@JvmStatic fun %s(%s)%s %s",
					kotlin_ident(camel(f.name)),
					strings.join(public_params[:], ", "),
					public_ret,
					"{",
				),
			)
			call := fmt.tprintf("%s(%s)", native_name, strings.join(call_args[:], ", "))
			if f.ret == "" {
				line(&b, 2, call)
			} else if e, ok := find_enum(module, f.ret); ok {
				line(&b, 2, fmt.tprintf("return %s.fromValue(%s)", e.name, call))
			} else {
				line(&b, 2, fmt.tprintf("return %s", call))
			}
			line(&b, 1, "}")
		} else {
			line(
				&b,
				1,
				fmt.tprintf(
					"@JvmStatic external fun %s(%s)%s",
					kotlin_ident(camel(f.name)),
					strings.join(params[:], ", "),
					ret_typ,
				),
			)
		}
	}
	line(&b, 1, "")
	line(&b, 1, "// Kotlin -> native (imports)")
	for f in module.functions {
		if f.direction != .Import do continue
		params := make([dynamic]string)
		for p in f.params {
			typ := kotlin_type_for(module, p.typ)
			if u, ok := enum_underlying(module, p.typ); ok do typ = kotlin_type(u)
			append(&params, fmt.tprintf("%s: %s", p.name, typ))
		}
		ret_typ := ""
		if f.ret != "" {
			typ := kotlin_type_for(module, f.ret)
			if u, ok := enum_underlying(module, f.ret); ok do typ = kotlin_type(u)
			ret_typ = strings.concatenate([]string{": ", typ})
		}
		line(
			&b,
			1,
			fmt.tprintf(
				"@JvmStatic fun %s(%s)%s %s",
				kotlin_ident(camel(f.name)),
				strings.join(params[:], ", "),
				ret_typ,
				"{",
			),
		)
		call_args := make([dynamic]string)
		for p in f.params {
			if e, ok := find_enum(module, p.typ); ok {
				append(&call_args, fmt.tprintf("%s.fromValue(%s)", e.name, p.name))
			} else {
				append(&call_args, p.name)
			}
		}
		call := fmt.tprintf(
			"platform?.%s(%s)",
			kotlin_ident(camel(f.name)),
			strings.join(call_args[:], ", "),
		)
		if f.ret == "" {
			if f.thread == "ui" || f.thread == "main" {
				line(&b, 2, strings.concatenate([]string{"mainHandler.post { ", call, " }"}))
			} else {
				line(&b, 2, call)
			}
		} else if e, ok := find_enum(module, f.ret); ok {
			line(
				&b,
				2,
				fmt.tprintf("return %s?.value ?: %s", call, kotlin_raw_default_for(module, f.ret)),
			)
		} else {
			line(&b, 2, fmt.tprintf("return %s ?: %s", call, kotlin_default_for(module, f.ret)))
		}
		line(&b, 1, "}")
	}
	line(&b, 0, "}")
	return write_text(path, strings.to_string(b))
}

emit_jni :: proc(module: Module, path, header_path: string) -> string {
	b := strings.Builder{}
	strings.builder_init(&b)
	include_path, rel_err := filepath.rel(filepath.dir(path), header_path)
	if rel_err != nil do include_path = filepath.base(header_path)
	line(&b, 0, "// generated by odinbinder - do not edit by hand.")
	line(&b, 0, "#include <jni.h>")
	line(&b, 0, "#include <string.h>")
	line(&b, 0, fmt.tprintf("#include %q", include_path))
	line(&b, 0, "")
	line(&b, 0, "static JavaVM *g_jvm;")
	line(&b, 0, "static jclass g_class;")
	for f in module.functions {
		if f.direction != .Import do continue
		line(&b, 0, fmt.tprintf("static jmethodID g_mid_%s;", camel(f.name)))
	}
	line(&b, 0, "")
	line(&b, 0, "JNIEXPORT jint JNICALL JNI_OnLoad(JavaVM *vm, void *reserved) {")
	line(&b, 1, "(void)reserved;")
	line(&b, 1, "g_jvm = vm;")
	line(&b, 1, "JNIEnv *env = 0;")
	line(&b, 1, "if ((*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) != JNI_OK) return JNI_ERR;")
	class_path, _ := strings.replace_all(module.android_pkg, ".", "/")
	line(
		&b,
		1,
		fmt.tprintf(
			"jclass local = (*env)->FindClass(env, \"%s/%s\");",
			class_path,
			module.android_class,
		),
	)
	line(&b, 1, "if (!local) return JNI_ERR;")
	line(&b, 1, "g_class = (*env)->NewGlobalRef(env, local);")
	for f in module.functions {
		if f.direction != .Import do continue
		sigs := make([dynamic]string)
		for p in f.params do append(&sigs, jni_sig_for(module, p.typ))
		kname := camel(f.name)
		line(
			&b,
			1,
			fmt.tprintf(
				"g_mid_%s = (*env)->GetStaticMethodID(env, g_class, \"%s\", \"(%s)%s\");",
				kname,
				kname,
				strings.join(sigs[:], ""),
				jni_sig_for(module, f.ret),
			),
		)
		line(&b, 1, fmt.tprintf("if (!g_mid_%s) return JNI_ERR;", kname))
	}
	line(&b, 1, "(*env)->DeleteLocalRef(env, local);")
	line(&b, 1, "return JNI_VERSION_1_6;")
	line(&b, 0, "}")
	line(&b, 0, "")
	line(&b, 0, "static JNIEnv *binding_env(void) {")
	line(&b, 1, "JNIEnv *env = 0;")
	line(&b, 1, "jint state = (*g_jvm)->GetEnv(g_jvm, (void **)&env, JNI_VERSION_1_6);")
	line(&b, 1, "if (state == JNI_EDETACHED) {")
	line(&b, 2, "#if defined(__ANDROID__)")
	line(&b, 2, "(*g_jvm)->AttachCurrentThread(g_jvm, &env, 0);")
	line(&b, 2, "#else")
	line(&b, 2, "(*g_jvm)->AttachCurrentThread(g_jvm, (void **)&env, 0);")
	line(&b, 2, "#endif")
	line(&b, 1, "}")
	line(&b, 1, "return env;")
	line(&b, 0, "}")
	line(&b, 0, "")
	line(&b, 0, "// Kotlin -> native (exports)")
	for f in module.functions {
		if f.direction != .Export do continue
		kname := kotlin_export_name(module, f)
		jni_params := make([dynamic]string)
		call_args := make([dynamic]string)
		prelude := make([dynamic]string)
		epilogue := make([dynamic]string)
		for p in f.params {
			append(&jni_params, fmt.tprintf("%s %s", jni_type_for(module, p.typ), p.name))
			if p.typ == "cstring" || is_nullable_cstring(p.typ) {
				if is_nullable_cstring(p.typ) {
					append(
						&prelude,
						fmt.tprintf(
							"const char *p_%s = %s ? (*env)->GetStringUTFChars(env, %s, 0) : 0;",
							p.name,
							p.name,
							p.name,
						),
					)
				} else {
					append(
						&prelude,
						fmt.tprintf(
							"const char *p_%s = (*env)->GetStringUTFChars(env, %s, 0);",
							p.name,
							p.name,
						),
					)
				}
				append(&call_args, fmt.tprintf("p_%s", p.name))
				if is_nullable_cstring(p.typ) {
					append(
						&epilogue,
						fmt.tprintf(
							"if (p_%s) (*env)->ReleaseStringUTFChars(env, %s, p_%s);",
							p.name,
							p.name,
							p.name,
						),
					)
				} else {
					append(
						&epilogue,
						fmt.tprintf(
							"(*env)->ReleaseStringUTFChars(env, %s, p_%s);",
							p.name,
							p.name,
						),
					)
				}
			} else {
				append(&call_args, p.name)
			}
		}
		pkg_u, _ := strings.replace_all(module.android_pkg, ".", "_")
		line(
			&b,
			0,
			fmt.tprintf(
				"JNIEXPORT %s JNICALL Java_%s_%s_%s(JNIEnv *env, jclass clazz%s) %s",
				jni_type_for(module, f.ret),
				pkg_u,
				module.android_class,
				kname,
				jni_params_suffix(jni_params[:]),
				"{",
			),
		)
		line(&b, 1, "(void)clazz;")
		for pl in prelude do line(&b, 1, pl)
		call := fmt.tprintf("%s(%s)", f.name, strings.join(call_args[:], ", "))
		if f.ret == "" {
			line(&b, 1, fmt.tprintf("%s;", call))
			for ep in epilogue do line(&b, 1, ep)
		} else if f.ret == "cstring" || is_nullable_cstring(f.ret) {
			line(&b, 1, fmt.tprintf("const char *result = %s;", call))
			line(&b, 1, "jstring jresult = result ? (*env)->NewStringUTF(env, result) : 0;")
			for ep in epilogue do line(&b, 1, ep)
			line(&b, 1, "return jresult;")
		} else {
			line(&b, 1, fmt.tprintf("%s result = %s;", jni_type_for(module, f.ret), call))
			for ep in epilogue do line(&b, 1, ep)
			line(&b, 1, "return result;")
		}
		line(&b, 0, "}")
		line(&b, 0, "")
	}
	line(&b, 0, "// native -> Kotlin (imports)")
	for f in module.functions {
		if f.direction != .Import do continue
		if f.ret == "cstring" do return fmt.tprintf("%s: import %s cannot return cstring", module.name, f.name)
		params := make([dynamic]string)
		for p in f.params do append(&params, fmt.tprintf("%s %s", c_type_for(module, p.typ), p.name))
		args := "void"
		if len(params) > 0 do args = strings.join(params[:], ", ")
		line(&b, 0, fmt.tprintf("%s %s(%s) %s", c_type_for(module, f.ret), f.name, args, "{"))
		line(&b, 1, "JNIEnv *env = binding_env();")
		line(
			&b,
			1,
			fmt.tprintf(
				"if (!env || !g_mid_%s) return%s;",
				camel(f.name),
				jni_return_default_for(module, f.ret),
			),
		)
		call_args := make([dynamic]string)
		locals := make([dynamic]string)
		for p, idx in f.params {
			if p.typ == "cstring" || is_nullable_cstring(p.typ) {
				if is_nullable_cstring(p.typ) {
					line(
						&b,
						1,
						fmt.tprintf(
							"jstring jarg%d = %s ? (*env)->NewStringUTF(env, %s) : 0;",
							idx,
							p.name,
							p.name,
						),
					)
				} else {
					line(
						&b,
						1,
						fmt.tprintf(
							"jstring jarg%d = (*env)->NewStringUTF(env, %s);",
							idx,
							p.name,
						),
					)
				}
				append(&call_args, fmt.tprintf("jarg%d", idx))
				if is_nullable_cstring(p.typ) {
					append(
						&locals,
						fmt.tprintf("if (jarg%d) (*env)->DeleteLocalRef(env, jarg%d);", idx, idx),
					)
				} else {
					append(&locals, fmt.tprintf("(*env)->DeleteLocalRef(env, jarg%d);", idx))
				}
			} else {
				append(&call_args, p.name)
			}
		}
		call := fmt.tprintf(
			"(*env)->%s(env, g_class, g_mid_%s%s)",
			jni_call_for(module, f.ret),
			camel(f.name),
			jni_args_suffix(call_args[:]),
		)
		if f.ret == "" {
			line(&b, 1, fmt.tprintf("%s;", call))
		} else {
			line(&b, 1, fmt.tprintf("return %s;", call))
		}
		for l in locals do line(&b, 1, l)
		line(&b, 0, "}")
		line(&b, 0, "")
	}
	return write_text(path, strings.to_string(b))
}

jni_params_suffix :: proc(params: []string) -> string {
	if len(params) == 0 do return ""
	return strings.concatenate([]string{", ", strings.join(params, ", ")})
}

jni_args_suffix :: proc(args: []string) -> string {
	if len(args) == 0 do return ""
	return strings.concatenate([]string{", ", strings.join(args, ", ")})
}

jni_return_default :: proc(name: string) -> string {
	switch name {
	case "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64":
		return " 0"
	case "f32", "f64":
		return " 0"
	case "bool":
		return " false"
	}
	return ""
}

swift_c_type :: proc(name: string) -> string {
	switch name {
	case "cstring":
		return "UnsafePointer<CChar>?"
	case "bool":
		return "Bool"
	}
	return swift_type(name)
}

swift_default :: proc(name: string) -> string {
	switch name {
	case "i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64":
		return "0"
	case "f32":
		return "0"
	case "f64":
		return "0"
	case "bool":
		return "false"
	}
	return ""
}

emit_swift :: proc(module: Module, path: string) -> string {
	b := strings.Builder{}
	strings.builder_init(&b)
	line(&b, 0, "// generated by odinbinder - do not edit by hand.")
	line(&b, 0, "import Foundation")
	line(&b, 0, "")
	for e in module.enums {
		line(&b, 0, fmt.tprintf("public enum %s: %s %s", e.name, swift_type(e.underlying), "{"))
		for f in e.fields {
			line(&b, 1, fmt.tprintf("case %s = %d", swift_ident(swift_case(f.name)), f.value))
		}
		line(&b, 0, "}")
		line(&b, 0, "")
	}
	line(&b, 0, fmt.tprintf("public enum %s %s", module.ios_module, "{"))
	line(&b, 1, "public protocol PlatformHandler {")
	for f in module.functions {
		if f.direction != .Import do continue
		params := make([dynamic]string)
		for p in f.params {
			append(&params, fmt.tprintf("_ %s: %s", p.name, swift_type_for(module, p.typ)))
		}
		ret := ""
		if f.ret != "" do ret = strings.concatenate([]string{" -> ", swift_type_for(module, f.ret)})
		line(
			&b,
			2,
			fmt.tprintf(
				"func %s(%s)%s",
				swift_ident(camel(f.name)),
				strings.join(params[:], ", "),
				ret,
			),
		)
	}
	line(&b, 1, "}")
	line(&b, 1, "")
	line(&b, 1, "public static var platform: PlatformHandler?")
	line(&b, 1, "")
	line(&b, 1, "// native -> Swift (exports)")
	for f in module.functions {
		if f.direction != .Export do continue
		params := make([dynamic]string)
		call_args := make([dynamic]string)
		prelude := make([dynamic]string)
		for p, i in f.params {
			append(&params, fmt.tprintf("_ %s: %s", p.name, swift_type_for(module, p.typ)))
			if p.typ == "cstring" {
				arg := fmt.tprintf("c%d", i)
				if f.ret == "" {
					append(&prelude, fmt.tprintf("%s.withCString %s c%d in", p.name, "{", i))
				} else {
					append(
						&prelude,
						fmt.tprintf("return %s.withCString %s c%d in", p.name, "{", i),
					)
				}
				append(&call_args, arg)
			} else if _, ok := find_enum(module, p.typ); ok {
				append(&call_args, fmt.tprintf("%s.rawValue", p.name))
			} else {
				append(&call_args, p.name)
			}
		}
		ret := ""
		if f.ret != "" do ret = strings.concatenate([]string{" -> ", swift_type_for(module, f.ret)})
		line(
			&b,
			1,
			fmt.tprintf(
				"public static func %s(%s)%s %s",
				swift_ident(camel(f.name)),
				strings.join(params[:], ", "),
				ret,
				"{",
			),
		)
		for pl in prelude do line(&b, 2, pl)
		call := fmt.tprintf("c_%s(%s)", f.name, strings.join(call_args[:], ", "))
		if f.ret == "" {
			line(&b, 2, call)
		} else if f.ret == "cstring" {
			line(&b, 2, fmt.tprintf("return String(cString: %s!)", call))
		} else if e, ok := find_enum(module, f.ret); ok {
			line(
				&b,
				2,
				fmt.tprintf(
					"return %s(rawValue: %s) ?? .%s",
					e.name,
					call,
					swift_ident(swift_case(enum_first_field(e))),
				),
			)
		} else {
			line(&b, 2, fmt.tprintf("return %s", call))
		}
		for _ in prelude do line(&b, 2, "}")
		line(&b, 1, "}")
		line(&b, 1, "")
	}
	line(&b, 0, "}")
	line(&b, 0, "")
	line(&b, 0, "// C entry points for exports (avoid Swift method/function name collisions)")
	for f in module.functions {
		if f.direction != .Export do continue
		params := make([dynamic]string)
		for p in f.params {
			append(&params, fmt.tprintf("_ %s: %s", p.name, swift_c_type_for(module, p.typ)))
		}
		ret := "Void"
		if f.ret != "" do ret = swift_c_type_for(module, f.ret)
		line(&b, 0, fmt.tprintf("@_silgen_name(%q)", f.name))
		line(
			&b,
			0,
			fmt.tprintf("private func c_%s(%s) -> %s", f.name, strings.join(params[:], ", "), ret),
		)
	}
	line(&b, 0, "")
	line(&b, 0, "// Swift implementations for imports")
	for f in module.functions {
		if f.direction != .Import do continue
		params := make([dynamic]string)
		exprs := make([dynamic]string)
		for p in f.params {
			append(&params, fmt.tprintf("_ %s: %s", p.name, swift_c_type_for(module, p.typ)))
			if e, ok := find_enum(module, p.typ); ok {
				append(
					&exprs,
					fmt.tprintf(
						"%s(rawValue: %s) ?? .%s",
						e.name,
						p.name,
						swift_ident(swift_case(enum_first_field(e))),
					),
				)
			} else if is_nullable_cstring(p.typ) {
				append(&exprs, fmt.tprintf("%s.map %s String(cString: $0) %s", p.name, "{", "}"))
			} else if p.typ == "cstring" {
				append(&exprs, fmt.tprintf("String(cString: %s!)", p.name))
			} else {
				append(&exprs, p.name)
			}
		}
		ret := "Void"
		if f.ret != "" do ret = swift_c_type_for(module, f.ret)
		line(&b, 0, fmt.tprintf("@_cdecl(%q)", f.name))
		line(
			&b,
			0,
			fmt.tprintf(
				"public func odinbinder_%s(%s) -> %s %s",
				f.name,
				strings.join(params[:], ", "),
				ret,
				"{",
			),
		)
		use_async := f.ret == "" && (f.thread == "ui" || f.thread == "main")
		call_args := make([dynamic]string)
		for expr, i in exprs {
			if use_async && expr != f.params[i].name {
				local := fmt.tprintf("%s_arg", f.params[i].name)
				line(&b, 1, fmt.tprintf("let %s = %s", local, expr))
				append(&call_args, local)
			} else {
				append(&call_args, expr)
			}
		}
		call := fmt.tprintf(
			"%s.platform?.%s(%s)",
			module.ios_module,
			swift_ident(camel(f.name)),
			strings.join(call_args[:], ", "),
		)
		if f.ret == "" {
			if use_async {
				line(
					&b,
					1,
					strings.concatenate([]string{"DispatchQueue.main.async { ", call, " }"}),
				)
			} else {
				line(&b, 1, call)
			}
		} else if _, ok := find_enum(module, f.ret); ok {
			line(
				&b,
				1,
				fmt.tprintf("return %s?.rawValue ?? %s", call, swift_raw_fallback(module, f.ret)),
			)
		} else {
			line(&b, 1, fmt.tprintf("return %s ?? %s", call, swift_default_for(module, f.ret)))
		}
		line(&b, 0, "}")
		line(&b, 0, "")
	}
	return write_text(path, strings.to_string(b))
}
