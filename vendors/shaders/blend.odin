blend_bg_shader_desc_gles3 :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
    desc: sg.Shader_Desc
    desc.label = "bg_shader"
    #partial switch backend {
    case .GLES3:
        desc.vertex_func.source = transmute(cstring)&blend_vs_bg_source_glsl300es
        desc.vertex_func.entry = "main"
        desc.fragment_func.source = transmute(cstring)&blend_fs_bg_source_glsl300es
        desc.fragment_func.entry = "main"
        desc.attrs[0].base_type = .FLOAT
        desc.attrs[0].glsl_name = "position"
        desc.uniform_blocks[0].stage = .FRAGMENT
        desc.uniform_blocks[0].layout = .STD140
        desc.uniform_blocks[0].size = 16
        desc.uniform_blocks[0].glsl_uniforms[0].type = .FLOAT4
        desc.uniform_blocks[0].glsl_uniforms[0].array_count = 1
        desc.uniform_blocks[0].glsl_uniforms[0].glsl_name = "bg_fs_params"
    }
    return desc
}
blend_quad_shader_desc_gles3 :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
    desc: sg.Shader_Desc
    desc.label = "quad_shader"
    #partial switch backend {
    case .GLES3:
        desc.vertex_func.source = transmute(cstring)&blend_vs_quad_source_glsl300es
        desc.vertex_func.entry = "main"
        desc.fragment_func.source = transmute(cstring)&blend_fs_quad_source_glsl300es
        desc.fragment_func.entry = "main"
        desc.attrs[0].base_type = .FLOAT
        desc.attrs[0].glsl_name = "position"
        desc.attrs[1].base_type = .FLOAT
        desc.attrs[1].glsl_name = "color0"
        desc.uniform_blocks[0].stage = .VERTEX
        desc.uniform_blocks[0].layout = .STD140
        desc.uniform_blocks[0].size = 64
        desc.uniform_blocks[0].glsl_uniforms[0].type = .FLOAT4
        desc.uniform_blocks[0].glsl_uniforms[0].array_count = 4
        desc.uniform_blocks[0].glsl_uniforms[0].glsl_name = "quad_vs_params"
    }
    return desc
}

blend_bg_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return blend_bg_shader_desc_gles3(backend)
	case .GLCORE:
		return blend_gl4_bg_shader_desc(backend)
	}
	return {}
}
blend_quad_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return blend_quad_shader_desc_gles3(backend)
	case .GLCORE:
		return blend_gl4_quad_shader_desc(backend)
	}
	return {}
}
