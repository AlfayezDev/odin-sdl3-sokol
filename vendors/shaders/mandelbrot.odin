mandelbrot_mandelbrot_shader_desc_gles3 :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
    desc: sg.Shader_Desc
    desc.label = "mandelbrot_shader"
    #partial switch backend {
    case .GLES3:
        desc.vertex_func.source = transmute(cstring)&mandelbrot_vs_source_glsl300es
        desc.vertex_func.entry = "main"
        desc.fragment_func.source = transmute(cstring)&mandelbrot_fs_source_glsl300es
        desc.fragment_func.entry = "main"
        desc.uniform_blocks[0].stage = .FRAGMENT
        desc.uniform_blocks[0].layout = .STD140
        desc.uniform_blocks[0].size = 32
        desc.uniform_blocks[0].glsl_uniforms[0].type = .FLOAT
        desc.uniform_blocks[0].glsl_uniforms[0].array_count = 1
        desc.uniform_blocks[0].glsl_uniforms[0].glsl_name = "_24.time"
        desc.uniform_blocks[0].glsl_uniforms[1].type = .FLOAT
        desc.uniform_blocks[0].glsl_uniforms[1].array_count = 1
        desc.uniform_blocks[0].glsl_uniforms[1].glsl_name = "_24.width"
        desc.uniform_blocks[0].glsl_uniforms[2].type = .FLOAT2
        desc.uniform_blocks[0].glsl_uniforms[2].array_count = 1
        desc.uniform_blocks[0].glsl_uniforms[2].glsl_name = "_24.aspect"
        desc.uniform_blocks[0].glsl_uniforms[3].type = .INT
        desc.uniform_blocks[0].glsl_uniforms[3].array_count = 1
        desc.uniform_blocks[0].glsl_uniforms[3].glsl_name = "_24.iter_max"
    }
    return desc
}

mandelbrot_mandelbrot_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return mandelbrot_mandelbrot_shader_desc_gles3(backend)
	case .GLCORE:
		return mandelbrot_gl4_mandelbrot_shader_desc(backend)
	}
	return {}
}
