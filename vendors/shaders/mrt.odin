mrt_fsq_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return mrt_fsq_shader_desc_gles3(backend)
	case .GLCORE:
		return mrt_gl4_fsq_shader_desc(backend)
	}
	return {}
}
mrt_offscreen_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return mrt_offscreen_shader_desc_gles3(backend)
	case .GLCORE:
		return mrt_gl4_offscreen_shader_desc(backend)
	}
	return {}
}
