offscreen_default_shader_desc :: proc "c" (backend: sg.Backend) -> sg.Shader_Desc {
	#partial switch backend {
	case .GLES3:
		return offscreen_default_shader_desc_gles3(backend)
	case .GLCORE:
		return offscreen_gl4_default_shader_desc(backend)
